{
  "expo": {
    "name": "Prep Copilot",
    "slug": "prep-copilot",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.prepcopilot.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.prepcopilot.mobile",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Pick a photo of practice material to get it explained.",
          "cameraPermission": "Take a photo of practice material to get it explained."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "b13c855b-95f2-4d2f-ad65-a3024eeaed80"
      }
    },
    "owner": "nswift1"
  }
}
